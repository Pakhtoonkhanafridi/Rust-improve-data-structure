# the logic mulitiplying Machine

numbers = [1, 2, 3, 4, 5]
doubled_numbers = [] # empty box for double numbers

for num in numbers:
    doubled = num * 2 # Double the current number
    doubled_numbers.append(doubled) # Put it in the new  box

print("Original:", numbers) # [1,2, 3, 4, 5]
print("Double:", doubled_numbers) # [2, 4, 6, 8, 10]

# The Word Detective
#let 's see how many times the letter "a" appear in the word

word = "banana banana"
count = 0

#  The loop will loop at each letter 

for letter in word:
    if letter == "a": # Is the current letter  "a"
        count += 1   # If yes , add 1 to the count
print(f"The letter 'a' appear {count} times in '{word}.'")
# The letter 'a' appears 3 times in 'banana'.

# The pary Invitation List

friends = {"KhanA": "blue", "Afridi": "Pak", "black" : "red"}

# .items() gives you both the key (name) and value (color)
for name, color in friends.items():
    print(f"Hi {name}! Please come to my party . I ' ll get you a {color} ballon.")

# You can also loop just through keys:

for name in friends:
    print(f"Hello, {name}!")

