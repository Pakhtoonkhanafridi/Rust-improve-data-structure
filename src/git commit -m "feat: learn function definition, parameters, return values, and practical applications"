def celsius_to_fahrenheit(celsius):
    fahrenheit = (celsius * (9/5) + 32)
    return fahrenheit

temp_c = 25
temp_f = celsius_to_fahrenheit(temp_c)

def count_vowels(text):
    vowels = "aeiouAEIOU"
    count = 0
    for char in text:
        if char in vowels:
            count += 1
    return count
    
#Use the Function
message = "Hello World"
vowel_count = count_vowels(message)
print(f"'{message}' has {vowel_count} vowels")
