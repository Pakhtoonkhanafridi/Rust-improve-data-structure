age = int(input("How old are you? "))
password = input("what's the secret password? ")

#the Bouncer checks Both rules using AND
if age >= 18 and password == "game":
    print("Welcome to the clubhouse!")
else:
    print("Sorry, you can't come in.")


# OR
shirt_color = input("What color is your shirt? ").lower()
brought_friend = input("Did you bring a friend? (yes/no)").lower()

# The Nice Bouncer checks if A least on rule is True using OR
if shirt_color == "red" or brought_friend == "yes":
    print("come on in!")
