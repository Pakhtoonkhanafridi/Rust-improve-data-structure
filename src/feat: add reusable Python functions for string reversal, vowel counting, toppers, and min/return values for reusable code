# Return values the Output
#the return statement sends a value back to the line where the #function was called . This how the function "give back" results.

def add_number(a, b):
    result= a + b
    print(f"The sum of a + b is {result}")

add_number(5, 4) 

def add_numbers(a, b):
    result = a + b
    return result # send the result back

sum_result = add_numbers(7, 8)
print(f"the sum is :{sum_result}")

double_sum =add_numbers(5, 3) *  2 # 16
print(f"Double  the sum: {double_sum}")

final_result = add_numbers(add_numbers(2, 3), 4) # (2+3) + 4 = 9
print(f"Final result:{final_result}")

# Temperature
def convert_temperature(value, from_unit, to_unit):
    """Convert temperature between Celsius and Fahrenheit."""
    if from_unit == 'C' and to_unit == 'F':
        return (value * 9/5) + 32
    elif from_unit == 'F' and to_unit == 'C':
        return (value - 32) * 5/9
    else:
        return value # Same unit , no conversion
    
# Use the function
c_temp = 25
f_temp = convert_temperature(c_temp,'C','F')
print(f"{c_temp}C = {f_temp} F") # Output: 25 C = 77.0 F

