def calculate_grade(score, max_score=100):
    """Calculate percentage and letter grade."""
    percentage = (score / max_score) * 100
    
    if percentage >= 90:
        grade = 'A'
    elif percentage >= 80:
        grade = 'B'
    elif percentage >= 70:
        grade = 'C'
    else:
        grade = 'F'
    
    return percentage, grade 

score = 95
percentage, grade = calculate_grade(score)
print(f"Score: {score}/{100} = {percentage}% -> Grade: {grade}")

