def bubble_sort(arr):
    """ sort a list using bubble sort algorithm.
    Return the sorted list.
    """
    n = len(arr)
    # Create a copy to avoid modifying original list
    sorted_arr = arr.copy()
    # Transerse through all array elements
    for i in range(n):
        # Last i element are already in place
        for j in range(0, n-i-1):
            # Traverse the array from 0 to n-i-1
            # Swap if the element found is greater than the next element
            if sorted_arr[j] > sorted_arr[j+1]:
                sorted_arr[j], sorted_arr[j + 1] = sorted_arr[j + 1], sorted_arr[j]
    return sorted_arr
numbers = [64, 34, 25, 12, 22, 11, 90]
print("Original array:", numbers)
print("Sorted array:", bubble_sort(numbers))

# Leaner Search in a List
def linear_search(arr, target):
    """
    Perform linear search on a list
    Returns index if found, -1 if not found.
    """
    for i in range(len(arr)):
        if arr[i] == target:
            return i # Return index where found
    return -1 

numbers = [10, 20, 30, 40, 50, 60]
target = 40

result = linear_search(numbers, target)
if result != -1:
    print(f"Element {target} found at index {result}")
else:
    print(f"Element {target} not found in the list")

print(linear_search(numbers, 100)) 

#3 Count Frequency of Words in a String
def count_word_frequency(text):
    """
    Counts frequency of each word in string. 
    Returns a dictionary with word frequencies.
    """
    #  Convert to lowercase and split in words
    words = text.lower().split()
    frequency = {}
    
    for word in words:
        # Remove punction if needed (basic version)
        word = word.strip('.,!?;:"')
        #counting frequency(word) 
        if word in frequency:
            frequency[word] += 1
        else:
            frequency[word] = 1
    return frequency
# test the function
text = "Hello world hello python world python programming"
freq = count_word_frequency(text)

print("Word frequencies:")
for word, count in freq.items():
    print(f"{word}: {count}")

#  check the palindrome
def is_palindrome(s):
    """
    Checks if a string is a palindrome.
    Returns True if palindrome, False otherwise.
    """
    # Clean the string : remove spaces, punction, and make lowercase
    cleaned = ''.join(char.lower() for char in s if char.isalnum())
    
    # Checks if cleaned string equals it reverse
    return cleaned == cleaned[::-1]

test_strings = [
        "racecar",
        "Hello",
        "A man a plan a canal panama",
        "12321",
        "Python"
]
    
for test in test_strings:
        result = is_palindrome(test)
        print(f"'{test}' -> {'Palindrome' if result else 'Not palinrome'}")
        
