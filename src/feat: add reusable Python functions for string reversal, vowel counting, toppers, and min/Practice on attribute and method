class Dog:
    def __init__(self, name):
        self.name = name
        self.hunger = 50 # 0 full , 100 =starving
    def bark(self):
        print(f"{self.name} says:Woof! Woof!")
    def feed(self, food_amount):
        self.hunger -= food_amount
        if self.hunger < 0:
            self.hunger = 0
        print(f"{self.name} was fed.Hunger level: {self.hunger}")
my_dog = Dog("Buddy")
my_dog.bark()
my_dog.feed(38)
