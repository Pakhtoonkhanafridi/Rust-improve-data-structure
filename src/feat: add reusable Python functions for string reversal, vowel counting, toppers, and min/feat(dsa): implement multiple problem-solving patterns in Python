#Example: Find first duplicate
def first_duplicate(nums):
    seen = set() # We choose set for O(1) check
    for num in seen:
        if num in seen: # Fast 0(1) check
            return num
        seen.add(num)
    return -1 
# Time Complexity: O(n)
