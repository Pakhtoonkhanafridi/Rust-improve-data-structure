class GameCharacter:
    # Class attribute
    game_version = "1.0"
    
    def __init__(self, name, character_class):
        # Instance attributes
        self.name = name
        self.character_class = character_class
        self.health = 100
        self.level = 1
        self.experience= 0
        self.inventory = []

    def attack(self):
        print(f"{self.name} attacts!")
        return 10 * self.level # Simple damage calculation
    
    def take_damage(self, damage):
        self.health -=damage
        if  self.health <= 0 :
            print(f"{self.name} has been defeated!")
        else:
            print(f"{self.name} took {damage} damage. Health: {self.health}")
    def heal(self, amount):
        self.health += amount
        print(f"{self.name} healed {amount} health points.")

    def add_to_inventory(self, item):
        self.inventory.append(item)
        print(f"{item} added to {self.name}'s inventory")
    @classmethod
    def update_game_version(cls, new_version):
        cls.gamer_version = new_version
        print(f"Game updated to version {new_version}")
    
    # specail method
    def __str__(self):
        return f"{self.name} (level {self.level} {self.character_class})"

hero = GameCharacter("Aragon", "Warrior")
print(hero)  # Aragon (Level 1 Warrior)

hero.add_to_inventory("Sword")
hero.add_to_inventory("Shield")

damage = hero.attack() # aragorn attacks!
hero.take_damage(30) # Arogarn took 30 damage. Health: 70
hero.heal(20) # Arogarn healed 20 health points

