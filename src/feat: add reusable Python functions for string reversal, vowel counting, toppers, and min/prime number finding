import math

def is_prime(n):
    """Check if a number is prime(optimized version). """
    if n < 2:
        return False
    if n == 2:         # is the only even prime
        return True
    if n % 2 == 0:
        return False
    
    # Check add divisors only, up to sqrt(n)
    for i in range(3, int(math.sqrt(n)) + 1, 2):
        if n % i == 0:
            return False
    
    return True

# Test the function
print(is_prime(17)) # True
print(is_prime(25)) # False (5*5)
print(is_prime(2)) # True

