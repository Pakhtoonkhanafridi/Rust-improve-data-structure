#  ERROR Handling
def is_prime(n):
    """Check if a number is prime with input validation. """
    try:
        n = int(n) # Convert  to integer if possible
    except (ValueError, TypeError):
        return False # Not a valid number
    
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    
    for i in range(3, int(n**0.5) + 1, 2):
        if n % i== 0:
            return False
    return True

print(is_prime(29)) # True
print(is_prime("29")) # True  (string converted to int)
print(is_prime(4.0)) # False (Float converted to int)
print(is_prime("abc")) # False (not a valid number)
