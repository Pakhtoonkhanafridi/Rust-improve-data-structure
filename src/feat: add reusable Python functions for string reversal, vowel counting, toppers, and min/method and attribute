def count_word_frequency(filename):
    """
    Counts how many times each word appears in a file.
    Returns a dictionary with word frequencies.
    """
    word_count = {}
    
    try:
        with open(filename, "r") as file:
            for line in file:
                # Convert to lower case and splite into words
                words = line.lower().split()
                for word in words:
                    # Remove punctuation form works
                    clean_word = word.strip(',.!?;:"()')
                    
                    if clean_word: # Only count now_empty words
                         if  clean_word in word_count:
                             word_count[clean_word] += 1
                         else:
                             word_count[clean_word]= 1
        return word_count
    except FileNotFounderError:
        print(f"Error: THe file {filename} was not found")
        return {}
def display_word_frequency(word_count):
    """
    Display the word frequency count in anice format
    """
    if not word_count:
        print("No words to display.")
        return
    
    print("\nWord Frequency Count:")
    print("-" * 25)
    
    # SOrt word by frequency (descending)
    sorted_words = sorted(word_count.items(), key=lambda x: x[1], reverse= True)    
    for word, count in sorted_words:
        print(f"{word}: {count}")
        
