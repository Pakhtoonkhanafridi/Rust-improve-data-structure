class Animal:
    def __init__(self, name):
        self.name = name
    def speak(self):
        print("Some generic animal sound")
    def sleep(self):
        print(f"{self.name} is sleeping ... zzz")

#Child class (derived class) -inheritance form Animal
class Dog(Animal): # Dog inherits from Animal
    def bark(self):
        print(f"{self.name} syas: Woof! Woof!")
    #overid the parent's speak method
    def speak(self):
        self.bark()

class Cat(Animal):  # Cat inherits from Animal
    def meow(self):
        print(f"{self.name} says: Meow!")
    def speak(self):
        self.meow()

my_dog = Dog("Buddy")
my_dog.speak() 

my_dog.bark()
my_dog.speak()
