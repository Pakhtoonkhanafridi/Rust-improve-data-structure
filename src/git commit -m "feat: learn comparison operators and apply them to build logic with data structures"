# your mix toy box
mixed_blocks = ["red", "blue", "blue", "red", "red"]
red_blocks = [] # New  box for red
blue_blocks = [] # New box for blue

for block in mixed_blocks:
    # for each block, ask a question
    if block == "red":
        red_blocks.append(block) # If Yes , put in red box
    else:
        blue_blocks.append(block) # If No , put in blue box

print("Red blocks:", red_blocks)
print("BLue blocks:", blue_blocks)

