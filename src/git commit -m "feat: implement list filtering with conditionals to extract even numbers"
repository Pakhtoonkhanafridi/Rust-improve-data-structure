# Searching for in a list of Dictionaries

contacts = [
    {'name': 'Ahmad', 'phone': '555-1234'},
    {'name': 'Pak', 'phone': '555-5678'},
    {'name': 'Afridi', 'phone': '555-9012'}
]

search_name = input("who are you looking for? ").title()
found_contact = None 

for contact in contacts:
    if contact["name"] == search_name:
        found_contact = contact
        break
    
if found_contact:
    print(f"Found {search_name}! Phone number: {found_contact['phone']}")
else:
    print(f"Sorry, {search_name} not found in contacts.")
