# The Guession Game
secret_number = 7
guess = None # We haven't guessed yet

while guess != secret_number: # Keep looping While the is wrong
    guess = int(input("Guesss a number 1 and 10: "))
    
    if guess < secret_number:
        print("Too low! Try again.")
    elif guess > secret_number:
        print("Too high! Try again.")
    else:
        print("You got it! ")

# The Patient Parent 
# Keep cleaning your room while it's still  messay.
room_is_clean = False # Start with messay  room

while not room_is_clean: # While the room is Not clean
    answer = input("Is your room clean yet? (yes/no)").lower()
    if answer == "yes":
        room_is_clean = True # This makes the condition false
        print("Good job! you can Play now.")
    else:
        print("Keep cleaning")
