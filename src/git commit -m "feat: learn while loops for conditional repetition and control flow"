# The countdown Rocket
# let's count down from 10 to 1 , then blast off!

count= 10

while count > 0 : # keep looping while count is greater than 0
    print(count)
    count = count -1 #  This is very important ! It changes the count
    # You can also write: count -=1
print("blast off!")

# The Never_ Ending Story (And How to Stop It!)
#this loop will run forever until you tell it to stop

while True:  # This condition is always True!
    answer = input("Say ' stop' to end the game: ").lower()

    if answer == "stop":
        print("Okay, game over!")
        break #The Magic Word to jump out of the loop immediately
    else:
        print("Let's keep going...")

# Break is like the emergency exit : It jump out of the loop whenever you want

