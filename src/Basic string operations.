# APPLYINF  the logic: Mini DSA Problem
# problem 1 : Check If a String ia Plindrome

# A palindrome reads the same forward and backward(e.g "radar").

#Logic :
#Normilize the string  remove spaces, make lowercase
# Compare the string to its reverse.

def is_palindrome(s):
    s = s.replace(" ","").lower()
    return s == s[::-1]
print(is_palindrome("A man a plan a canal Panama"))

