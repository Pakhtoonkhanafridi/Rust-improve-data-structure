# Problem 2 : Count the Frequency of a Charater

# Logix 
# Normailize the (e.g, make lowercase for case-insensitive cout).
#Loop through each character
# Use a dictionary to keeep a running count

def count_chars(s):
    s= s.lower()
    freq = {}
    for char in s:
        if char != " ":
            freq[char] = freq.get(char, 0) + 1
    return freq
print(count_chars("Hello World"))

# Problem 3 : Reverse WOrds in a String 
# Give "the sky is blue" -> OUtpout : "blue is sky the" "

# logic 
#split() the string into a list of words
# reverse() the list
# join() the list back into a string with spaces

def reverse_words(s):
    words = s.split() # splict into list: ['the', 'sky', "is , "ble"]

    words.reverse() # rReverse the list : ['blue','is ', 'sky', 'the']
    return " ".join(words) # Join with spaces: "blue is sky the"
print(reverse_words("the sky is blue"))
